---
import { Image } from "astro:assets";
import portrait from "../assets/img/lifestyle-woman-sea.jpg";
import arches from "../assets/img/architecture-arches-sunset.jpg";
import { t, type Locale } from "../data/content";

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = t(locale);
---

<section id="about" class="relative overflow-hidden bg-paper py-32 md:py-48">
  <span class="palm palm--tl" aria-hidden="true"></span>

  <div class="shell relative">
    <!-- Asymmetric editorial: prose sits on a 7-column measure, the portrait
         breaks the grid and runs past the section padding. -->
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <h2 class="text-[clamp(2rem,4.4vw,3.25rem)] font-light leading-[1.08] tracking-[-0.02em]">
          {c.about.title}
        </h2>
        <p class="lockup__alt mt-2">{c.about.alt}</p>
        <span class="lockup__rule"></span>

        <p class="js-reveal mt-9 max-w-[58ch] text-[1.15rem] font-light leading-[1.75] text-ink/85">
          {c.about.body}
        </p>

        <dl class="mt-14 grid gap-10 sm:grid-cols-2">
          <div class="js-reveal border-t border-espresso/15 pt-6">
            <dt class="text-[0.95rem] font-medium">{c.about.vision.title}</dt>
            <dd class="mt-3 text-[0.975rem] font-light leading-relaxed text-ink/70">
              {c.about.vision.body}
            </dd>
          </div>
          <div class="js-reveal border-t border-espresso/15 pt-6">
            <dt class="text-[0.95rem] font-medium">{c.about.mission.title}</dt>
            <dd class="mt-3 text-[0.975rem] font-light leading-relaxed text-ink/70">
              {c.about.mission.body}
            </dd>
          </div>
        </dl>
      </div>

      <div class="js-reveal lg:col-span-5">
        <Image
          src={portrait}
          alt="A member looking out to the Red Sea from the SOL shoreline"
          widths={[420, 700, 1000]}
          sizes="(min-width: 1024px) 34vw, 90vw"
          class="aspect-[3/4] w-full rounded-[2px] object-cover"
        />
        <Image
          src={arches}
          alt="The arched terraces at SOL in evening light"
          widths={[320, 560, 800]}
          sizes="(min-width: 1024px) 22vw, 60vw"
          class="-mt-24 ms-auto me-0 hidden w-[62%] rounded-[2px] object-cover shadow-[0_30px_70px_-30px_rgba(36,26,21,0.45)] lg:block"
          style="aspect-ratio: 3 / 4;"
        />
      </div>
    </div>

    <!-- Three facts, plain. No cards: hairlines carry the grouping. -->
    <div class="js-reveal mt-24 grid gap-px overflow-hidden border-y border-espresso/12 sm:grid-cols-3">
      <div class="py-8 pe-8">
        <p class="text-[2.4rem] font-light leading-none tabular-nums">35,610</p>
        <p class="mt-2 text-[0.85rem] text-ink/55">{locale === "ar" ? "متر مربع" : "square metres"}</p>
      </div>
      <div class="border-espresso/12 py-8 sm:border-s sm:px-8">
        <p class="text-[2.4rem] font-light leading-none tabular-nums">2021</p>
        <p class="mt-2 text-[0.85rem] text-ink/55">{locale === "ar" ? "سنة التأسيس" : "established"}</p>
      </div>
      <div class="border-espresso/12 py-8 sm:border-s sm:ps-8">
        <p class="text-[2.4rem] font-light leading-none tabular-nums">11</p>
        <p class="mt-2 text-[0.85rem] text-ink/55">{locale === "ar" ? "مرفقًا" : "facilities on site"}</p>
      </div>
    </div>
  </div>
</section>

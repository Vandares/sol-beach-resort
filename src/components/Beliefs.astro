---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { t, type Locale } from "../data/content";

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = t(locale);

const files = import.meta.glob<{ default: ImageMetadata }>("../assets/img/*.jpg", { eager: true });
const pick = (n: string) => files[`../assets/img/${n}.jpg`]!.default;

// One photograph per belief, chosen to carry the idea rather than decorate it.
const cells = [
  { img: pick("lifestyle-sunset-woman-hat"), alt: "A member alone on the shoreline at sunset", wide: true },
  { img: pick("resort-sunset-a"), alt: "The resort at sunset", wide: false },
  { img: pick("lifestyle-morning-calm"), alt: "A slow morning at SOL", wide: false },
  { img: pick("diwaniyah-lounge"), alt: "Details in the Diwaniyah lounge", wide: true },
].map((cell, i) => ({ ...cell, text: c.beliefs.items[i]! }));
---

<section class="bg-paper py-32 md:py-48">
  <div class="shell">
    <div class="max-w-[52ch]">
      <h2 class="text-[clamp(2rem,4.4vw,3.25rem)] font-light leading-[1.08] tracking-[-0.02em]">
        {c.beliefs.title}
      </h2>
      <p class="lockup__alt mt-2">{c.beliefs.alt}</p>
      <span class="lockup__rule"></span>
      <p class="js-reveal mt-8 text-[1.0625rem] font-light leading-[1.75] text-ink/75">
        {c.beliefs.lede}
      </p>
    </div>

    <!-- Four beliefs, four photographs. Widths alternate two-then-one and
         one-then-two so the grid has rhythm instead of being a flat 2x2. -->
    <div class="mt-16 grid gap-4 md:grid-cols-3 md:gap-5">
      {cells.map((cell) => (
        <figure
          class:list={[
            "js-reveal relative overflow-hidden rounded-[2px]",
            cell.wide && "md:col-span-2",
          ]}
        >
          <Image
            src={cell.img}
            alt={cell.alt}
            widths={[440, 760, 1100]}
            sizes={cell.wide ? "(min-width: 768px) 62vw, 92vw" : "(min-width: 768px) 30vw, 92vw"}
            class="h-[19rem] w-full object-cover md:h-[24rem]"
          />
          <span
            class="absolute inset-0 bg-linear-to-t from-espresso/88 via-espresso/30 to-espresso/5"
            aria-hidden="true"
          ></span>
          <figcaption class="absolute inset-x-0 bottom-0 p-8 md:p-9">
            <p class="max-w-[24ch] text-[1.2rem] font-light leading-snug text-paper md:text-[1.35rem]">
              {cell.text}
            </p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

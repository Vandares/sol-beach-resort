---
import { t, CONTACT, type Locale } from "../data/content";

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = t(locale);
---

<section class="bg-paper-2 py-32 md:py-44">
  <div class="shell">
    <div class="flex flex-wrap items-end justify-between gap-6 border-t border-espresso/12 pt-16">
      <div>
        <h2 class="text-[clamp(1.75rem,3.4vw,2.5rem)] font-light tracking-[-0.02em]">{c.reviews.title}</h2>
        <p class="lockup__alt mt-2">{c.reviews.alt}</p>
      </div>
      <p class="text-[0.9rem] text-ink/55">
        <span class="text-[2rem] font-light leading-none text-ink tabular-nums">{CONTACT.rating}</span>
        <span class="mx-2 text-gold-ink" aria-hidden="true">&#9733;</span>
        <span>{c.reviews.stat} <span class="tabular-nums">{CONTACT.reviewCount}</span></span>
      </p>
    </div>

    <!-- Quotes, not cards. Hairlines separate them and each sits at a
         slightly different height so the row is not a rigid triptych. -->
    <div class="mt-16 grid gap-12 md:grid-cols-3 md:gap-0">
      {c.reviews.items.map((r, i) => (
        <figure
          class:list={[
            "js-reveal md:border-espresso/12 md:ps-10",
            i > 0 && "md:border-s",
            i === 0 && "md:pe-10 md:ps-0",
            i === 1 && "md:pe-10 md:pt-8",
            i === 2 && "md:pt-16",
          ]}
        >
          <blockquote class="text-[1.05rem] font-light leading-[1.7] text-ink/85" dir="ltr" lang="en">
            {r.quote}
          </blockquote>
          <figcaption class="mt-5 text-[0.85rem] text-ink/55">{r.name}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

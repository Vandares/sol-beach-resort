---
import { Image } from "astro:assets";
import captain from "../assets/img/ride-captain.jpg";
import { t, type Locale } from "../data/content";

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = t(locale);
---

<!--
  A short section, deliberately. The photograph is a tall portrait, so it takes
  the narrower column and the copy sits beside it rather than under it.
-->
<section id="rides" class="bg-paper-2 py-32 md:py-48">
  <div class="shell grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
    <figure class="js-reveal lg:col-span-5">
      <Image
        src={captain}
        alt="A SOL captain beside the resort buggy"
        widths={[420, 700, 1066]}
        sizes="(min-width: 1024px) 34vw, 90vw"
        class="aspect-[3/4] w-full rounded-[2px] object-cover"
      />
      <figcaption class="mt-3 text-[0.825rem] text-ink/55">{c.rides.caption}</figcaption>
    </figure>

    <div class="lg:col-span-6 lg:col-start-7">
      <h2 class="text-[clamp(2rem,4.4vw,3.25rem)] font-light leading-[1.08] tracking-[-0.02em]">
        {c.rides.title}
      </h2>
      <p class="lockup__alt mt-2">{c.rides.alt}</p>
      <span class="lockup__rule"></span>

      <p class="js-reveal mt-8 max-w-[52ch] text-[1.0625rem] font-light leading-[1.8] text-ink/75">
        {c.rides.body}
      </p>

      <ul class="mt-9 max-w-[42ch]">
        {c.rides.points.map((p) => (
          <li class="js-reveal border-t border-espresso/12 py-4 text-[1rem] font-light">{p}</li>
        ))}
      </ul>
    </div>
  </div>
</section>
